<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تطبيق الرقابة والتدقيق لمسابقات التوظيف - ولاية تلمسان</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Cairo -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <!-- jsPDF for generating printable reports -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        dzgreen: '#006233',
                        dzred: '#d21034',
                        dzgold: '#d4af37',
                        dzdark: '#1e293b'
                    },
                    fontFamily: {
                        cairo: ['Cairo', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f1f5f9;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        @media print {
            .no-print { display: none !important; }
            .print-only { display: block !important; }
            body { background: white !important; font-size: 12pt; }
            .print-card { border: none !important; box-shadow: none !important; }
        }
        .print-only { display: none; }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 antialiased min-h-screen flex flex-col justify-between">

    <!-- Official Top Bar -->
    <header class="bg-dzgreen text-white shadow-lg no-print sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap justify-between items-center gap-2">
            <div class="flex items-center space-x-3 space-x-reverse">
                <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center text-dzgreen font-bold text-xl shadow">
                    <i class="fa-solid font-bold text-dzred text-xl">🏛️</i>
                </div>
                <div>
                    <h1 class="font-bold text-base md:text-lg leading-tight">الجمهورية الجزائرية الديمقراطية الشعبية</h1>
                    <p class="text-xs text-emerald-100">المديرية العامة للوظيفة العمومية والإصلاح الإداري - مفتشية ولاية تلمسان</p>
                </div>
            </div>
            <div class="flex items-center space-x-2 space-x-reverse">
                <span class="bg-emerald-800 text-emerald-100 text-xs px-3 py-1.5 rounded-full border border-emerald-600 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    نظام الرقابة الآلية v2.4
                </span>
                <button onclick="resetAllData()" class="bg-red-600 hover:bg-red-700 text-white text-xs px-2.5 py-1.5 rounded transition flex items-center gap-1" title="إعادة ضبط البيانات">
                    <i class="fa-solid fa-rotate"></i>
                    <span class="hidden sm:inline">تهيئة</span>
                </button>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-3 sm:px-6 py-6 w-full flex-grow">

        <!-- Top Controls: Selection of Municipality & Position -->
        <section class="bg-white rounded-2xl shadow-sm border border-slate-200 p-4 sm:p-6 mb-6 no-print">
            <div class="flex items-center justify-between border-b pb-3 mb-4">
                <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                    <i class="fa-solid fa-sliders text-dzgreen"></i>
                    تحديد إطار المسابقة والبلدية المستهدفة
                </h2>
                <span class="text-xs text-slate-500">مرسوم تنفيذي رقم 08-04 و المنشور رقم 01/2020</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- Municipality Select -->
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">البلدية المعنية (ولاية تلمسان)</label>
                    <select id="selectMunicipality" onchange="updateCompetitionContext()" class="w-full bg-slate-50 border border-slate-300 text-slate-800 text-sm rounded-lg p-2.5 focus:ring-emerald-500 focus:border-emerald-500 font-semibold">
                        <!-- Populated by JS -->
                    </select>
                </div>

                <!-- Job Rank Select -->
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">الرتبة / المنصب المطلوب</label>
                    <select id="selectRank" onchange="updateCompetitionContext()" class="w-full bg-slate-50 border border-slate-300 text-slate-800 text-sm rounded-lg p-2.5 focus:ring-emerald-500 focus:border-emerald-500 font-semibold">
                        <option value="حارس">حارس (Guard)</option>
                        <option value="عامل مهني مستوى 1">عامل مهني من المستوى الأول (OP1)</option>
                        <option value="عامل مهني مستوى 2">عامل مهني من المستوى الثاني (OP2)</option>
                        <option value="عامل مهني مستوى 3">عامل مهني من المستوى الثالث (OP3)</option>
                        <option value="سائق سيارة من المستوى الأول">سائق سيارة من المستوى الأول</option>
                    </select>
                </div>

                <!-- Open Posts Count -->
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">عدد المناصب المالية المفتوحة</label>
                    <div class="flex items-center gap-2">
                        <input type="number" id="openPostsInput" min="1" max="50" value="3" onchange="updateCompetitionContext()" class="w-full bg-slate-50 border border-slate-300 text-slate-800 text-sm rounded-lg p-2.5 focus:ring-emerald-500 focus:border-emerald-500 font-bold">
                        <span class="text-xs bg-emerald-100 text-dzgreen font-bold px-3 py-2.5 rounded-lg border border-emerald-200 whitespace-nowrap">
                            مناصب معتمدة
                        </span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Dynamic Statistics Cards -->
        <section class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 mb-6 no-print">
            <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs text-slate-500 font-bold">إجمالي المترشحين</p>
                    <p id="kpiTotal" class="text-2xl font-black text-slate-800 mt-1">0</p>
                </div>
                <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center text-lg">
                    <i class="fa-solid fa-users"></i>
                </div>
            </div>

            <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs text-emerald-600 font-bold">المقبولون (قائمة الناجحين)</p>
                    <p id="kpiPassed" class="text-2xl font-black text-emerald-600 mt-1">0</p>
                </div>
                <div class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
            </div>

            <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs text-amber-600 font-bold">قائمة الانتظار</p>
                    <p id="kpiWaiting" class="text-2xl font-black text-amber-600 mt-1">0</p>
                </div>
                <div class="w-10 h-10 rounded-full bg-amber-50 text-amber-600 flex items-center justify-center text-lg">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                </div>
            </div>

            <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs text-rose-600 font-bold">الملفات المرفوضة قانوناً</p>
                    <p id="kpiRejected" class="text-2xl font-black text-rose-600 mt-1">0</p>
                </div>
                <div class="w-10 h-10 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center text-lg">
                    <i class="fa-solid fa-user-slash"></i>
                </div>
            </div>
        </section>

        <!-- Main Workspace Tabs -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden mb-6 no-print">
            <div class="flex border-b border-slate-200 bg-slate-50/80 overflow-x-auto">
                <button onclick="switchTab('candidates')" id="tabBtn-candidates" class="tab-btn px-5 py-3.5 text-sm font-bold border-b-2 border-dzgreen text-dzgreen bg-white flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-list-check"></i> قائمة المترشحين والتنقيط
                </button>
                <button onclick="switchTab('addCandidate')" id="tabBtn-addCandidate" class="tab-btn px-5 py-3.5 text-sm font-bold border-b-2 border-transparent text-slate-600 hover:text-slate-900 flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-user-plus"></i> تسجيل مترشح جديد
                </button>
                <button onclick="switchTab('audit')" id="tabBtn-audit" class="tab-btn px-5 py-3.5 text-sm font-bold border-b-2 border-transparent text-slate-600 hover:text-slate-900 flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-shield-halved"></i> سجل الرقابة والتفتيش (<span id="auditBadgeCount" class="text-xs bg-rose-100 text-rose-700 px-1.5 py-0.5 rounded-full">0</span>)
                </button>
                <button onclick="switchTab('reports')" id="tabBtn-reports" class="tab-btn px-5 py-3.5 text-sm font-bold border-b-2 border-transparent text-slate-600 hover:text-slate-900 flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-file-signature"></i> المحاضر والتقارير الرسمية
                </button>
            </div>

            <!-- TAB 1: Candidates List & Ranking -->
            <div id="tabContent-candidates" class="p-4 sm:p-6 tab-content">
                <div class="flex flex-col md:flex-row justify-between items-center gap-3 mb-4">
                    <div class="relative w-full md:w-72">
                        <i class="fa-solid fa-magnifying-glass absolute right-3 top-3 text-slate-400"></i>
                        <input type="text" id="searchInput" onkeyup="renderCandidatesTable()" placeholder="بحث بالاسم، اللقب أو ب.ت.و..." class="w-full bg-slate-50 border border-slate-300 pr-9 pl-3 py-2 rounded-lg text-sm focus:ring-emerald-500 focus:border-emerald-500">
                    </div>
                    <div class="flex items-center gap-2 w-full md:w-auto justify-end">
                        <select id="filterStatus" onchange="renderCandidatesTable()" class="bg-slate-50 border border-slate-300 text-xs rounded-lg px-3 py-2 font-semibold text-slate-700">
                            <option value="ALL">جميع الحالات</option>
                            <option value="PASSED">الناجحون المقبولون</option>
                            <option value="WAITING">قائمة الانتظار</option>
                            <option value="REJECTED">المرفوضون قانوناً</option>
                        </select>
                        <button onclick="exportDataJSON()" class="bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs px-3 py-2 rounded-lg font-bold flex items-center gap-1">
                            <i class="fa-solid fa-download"></i> تصدير البيانات
                        </button>
                    </div>
                </div>

                <div class="overflow-x-auto rounded-xl border border-slate-200">
                    <table class="w-full text-sm text-right text-slate-600">
                        <thead class="text-xs text-slate-700 uppercase bg-slate-100/80 border-b border-slate-200">
                            <tr>
                                <th class="px-3 py-3 text-center">الرتبة</th>
                                <th class="px-4 py-3">المترشح (الاسم واللقب)</th>
                                <th class="px-3 py-3">المستوى / المؤهل</th>
                                <th class="px-3 py-3 text-center">الخبرة (سنة)</th>
                                <th class="px-3 py-3 text-center">الوضعية العائلية</th>
                                <th class="px-3 py-3 text-center">المقابلة (/3)</th>
                                <th class="px-3 py-3 text-center">المجموع النهائي</th>
                                <th class="px-3 py-3 text-center">النتيجة والوضعية</th>
                                <th class="px-3 py-3 text-center">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody id="candidatesTbody">
                            <!-- Populated dynamically via JS -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TAB 2: Add / Edit Candidate Form -->
            <div id="tabContent-addCandidate" class="p-4 sm:p-6 tab-content hidden">
                <form id="candidateForm" onsubmit="handleCandidateSubmit(event)" class="space-y-6">
                    <input type="hidden" id="editCandidateId" value="">

                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                        <h3 class="text-sm font-bold text-slate-800 mb-3 text-dzgreen flex items-center gap-2">
                            <i class="fa-solid fa-address-card"></i> 1. الهوية والمعلومات الشخصية
                        </h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">اللقب *</label>
                                <input type="text" id="candLastName" required class="w-full border border-slate-300 rounded-lg p-2 text-sm focus:ring-emerald-500">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">الاسم *</label>
                                <input type="text" id="candFirstName" required class="w-full border border-slate-300 rounded-lg p-2 text-sm focus:ring-emerald-500">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">رقم بطاقة التعريف الوطنية *</label>
                                <input type="text" id="candNIN" required pattern="[0-9]{9,18}" placeholder="مثال: 11823000..." class="w-full border border-slate-300 rounded-lg p-2 text-sm focus:ring-emerald-500">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">تاريخ الميلاد *</label>
                                <input type="date" id="candBirthDate" required class="w-full border border-slate-300 rounded-lg p-2 text-sm focus:ring-emerald-500">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">بلدية الإقامة (ولاية تلمسان) *</label>
                                <select id="candResidence" required class="w-full border border-slate-300 rounded-lg p-2 text-sm focus:ring-emerald-500">
                                    <!-- Populated dynamically -->
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">وضعية الخدمة الوطنية *</label>
                                <select id="candMilitary" class="w-full border border-slate-300 rounded-lg p-2 text-sm focus:ring-emerald-500">
                                    <option value="مؤدى">مؤدى (مؤدى الخدمة)</option>
                                    <option value="معفى">معفى لأسباب طبية / عائلية</option>
                                    <option value="مؤجل">تأجيل نافذ المفعول</option>
                                    <option value="غير_مسوى">غير مسوى (سبب للرفض)</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                        <h3 class="text-sm font-bold text-slate-800 mb-3 text-dzgreen flex items-center gap-2">
                            <i class="fa-solid fa-graduation-cap"></i> 2. المؤهل الدراسي والخبرة المهنية
                        </h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">المستوى الدراسي المصرح به *</label>
                                <select id="candEducation" class="w-full border border-slate-300 rounded-lg p-2 text-sm focus:ring-emerald-500">
                                    <option value="ابتدائي">ابتدائي أو بدون شهادة</option>
                                    <option value="متوسط">متوسط (السنة الرابعة متوسط)</option>
                                    <option value="ثانوي">ثانوي (السنة الثالثة ثانوي)</option>
                                    <option value="تكوين_مهني">شهادة الكفاءة المهنية (CAP / CQP)</option>
                                    <option value="جامعي">جامعي (ليسانس أو أطوار جامعية)</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">سنوات الخبرة في القطاع العام (مؤكدة بـ CNAS) *</label>
                                <input type="number" id="candExpPublic" min="0" max="30" value="0" class="w-full border border-slate-300 rounded-lg p-2 text-sm focus:ring-emerald-500">
                                <span class="text-[10px] text-slate-500">1 نقطة عن كل سنة (أقصى حد 6 نقاط)</span>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">سنوات الخبرة في القطاع الخاص (مؤكدة) *</label>
                                <input type="number" id="candExpPrivate" min="0" max="30" value="0" class="w-full border border-slate-300 rounded-lg p-2 text-sm focus:ring-emerald-500">
                                <span class="text-[10px] text-slate-500">0.5 نقطة عن كل سنة (أقصى حد 3 نقاط)</span>
                            </div>
                        </div>
                    </div>

                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-20
